#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd)"
RUNTIME="$APP_DIR/irenx-local.mjs"
PORT="${IRENX_PORT:-8787}"
URL="${IRENX_LOCAL_URL:-http://127.0.0.1:${PORT}}"
PIDFILE="${IRENX_HOME:-$HOME/.irenx}/irenx.pid"

usage(){ cat <<'EOF'
🔥 IRENX TERMUX NO-API

Commands:
  irenx start
  irenx stop
  irenx restart
  irenx status
  irenx health
  irenx market [SYMBOL]
  irenx signal [SYMBOL]
  irenx scalping [SYMBOL]
  irenx prime [SYMBOL]
  irenx ask "IRENX TEST"

No OpenAI API, Twelve Data API, Cloudflare, or WhatsApp is required.
Local OHLC data: ~/.irenx/market.json
EOF
}

running(){ curl -sS --max-time 2 "$URL/api/health" >/dev/null 2>&1; }
start(){
  [[ -f "$RUNTIME" ]] || { echo "Runtime tidak ditemukan: $RUNTIME" >&2; exit 1; }
  if running; then echo "IRENX sudah berjalan: $URL"; return; fi
  mkdir -p "$(dirname "$PIDFILE")"
  nohup node "$RUNTIME" >"${IRENX_LOG_FILE:-${IRENX_HOME:-$HOME/.irenx}/irenx.log}" 2>&1 &
  echo $! > "$PIDFILE"
  for _ in $(seq 1 20); do if running; then echo "IRENX ONLINE: $URL"; return; fi; sleep 0.25; done
  echo "IRENX gagal start. Log:" >&2
  tail -n 40 "${IRENX_LOG_FILE:-${IRENX_HOME:-$HOME/.irenx}/irenx.log}" >&2 || true
  exit 1
}
stop(){ if [[ -f "$PIDFILE" ]]; then pid=$(cat "$PIDFILE" 2>/dev/null || true); if [[ "$pid" =~ ^[0-9]+$ ]]; then kill "$pid" 2>/dev/null || true; fi; rm -f "$PIDFILE"; fi; echo "IRENX stopped"; }
status(){ if running; then echo "IRENX ONLINE: $URL"; else echo "IRENX OFFLINE: $URL"; return 1; fi; }
health(){ curl -sS --max-time 5 "$URL/api/health"; printf '\n'; }
market(){ local s="${1:-XAUUSD}"; curl -sS --max-time 5 "$URL/api/market?symbol=$(printf '%s' "$s" | tr '[:lower:]' '[:upper:]')"; printf '\n'; }
ask(){ [[ $# -ge 1 ]] || { echo 'Usage: irenx ask "question"' >&2; exit 2; }; local p; p="$(node -e 'process.stdout.write(JSON.stringify({prompt:process.argv[1]}))' "$1")"; curl -sS --max-time 10 -X POST "$URL/api/ai" -H 'content-type: application/json' --data-binary "$p"; printf '\n'; }

case "${1:-help}" in
 start) start;; stop) stop;; restart) stop; start;; status) status;; health) start >/dev/null; health;; market) start >/dev/null; market "${2:-XAUUSD}";; signal|scalping|prime) start >/dev/null; ask "IRENX ${1^^} ${2:-XAUUSD}";; ask) start >/dev/null; shift; ask "$*";; help|-h|--help) usage;; *) echo "Unknown command: $1" >&2; usage >&2; exit 2;; esac
