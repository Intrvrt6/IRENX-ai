#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_PATH="$0"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED_PATH="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || true)"
else
  RESOLVED_PATH=""
fi
if [[ -n "$RESOLVED_PATH" && -f "$RESOLVED_PATH" ]]; then
  SCRIPT_PATH="$RESOLVED_PATH"
fi

ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
LOCAL_URL="${IRENX_LOCAL_URL:-http://127.0.0.1:${IRENX_PORT:-8787}}"

usage() {
  cat <<'EOF'
🔥 IRENX Termux — STANDALONE LOCAL MODE

Usage:
  irenx start
  irenx health
  irenx signal [XAUUSD]
  irenx scalping [XAUUSD]
  irenx prime [XAUUSD]
  irenx ask "your question"

Environment:
  OPENAI_API_KEY=your-key
  IRENX_OPENAI_MODEL=gpt-5.6
  IRENX_PORT=8787
  IRENX_MARKET_DATA_URL=optional JSON market-data endpoint

No ai.irenx.com deployment is required.
EOF
}

start() {
  local runtime="$ROOT/termux/irenx-local.mjs"
  if [[ ! -f "$runtime" ]]; then
    echo "IRENX local runtime tidak ditemukan: $runtime" >&2
    exit 1
  fi
  if [[ -z "${OPENAI_API_KEY:-}" ]]; then
    echo "OPENAI_API_KEY belum diset." >&2
    echo 'Set dengan: export OPENAI_API_KEY="..."' >&2
    exit 1
  fi
  exec node "$runtime"
}

health() {
  curl -fsS --max-time 10 "$LOCAL_URL/api/health"
  printf '\n'
}

ask() {
  local prompt="$1"
  node -e 'process.stdout.write(JSON.stringify({prompt:process.argv[1]}))' "$prompt" \
    | curl -fsS --max-time 90 -X POST "$LOCAL_URL/api/ai" \
        -H 'content-type: application/json' \
        --data-binary @-
  printf '\n'
}

case "${1:-help}" in
  start) start ;;
  health) health ;;
  signal)
    symbol="${2:-XAUUSD}"
    ask "IRENX SIGNAL $symbol. Analyze using REGIME -> LIQUIDITY -> REFLEXIVITY -> OROCHI -> VMAP -> EXECUTION -> RISK MANAGEMENT. Return Bias, Entry/Zone, SL, TP1, TP2, TP3, Trigger/Confirmation, and Status. Use verified market data only. If live data is unavailable, return WAIT/NO TRADE and do not fabricate numeric levels." ;;
  scalping)
    symbol="${2:-XAUUSD}"
    ask "IRENX SCALPING $symbol. Use REGIME -> LIQUIDITY -> REFLEXIVITY -> OROCHI -> VMAP -> EXECUTION -> RISK MANAGEMENT. Be highly selective. Return Bias, Entry/Zone, SL, TP1, TP2, TP3, Trigger/Confirmation, and Status. Use verified market data only. If live data is unavailable, return WAIT/NO TRADE and do not fabricate numeric levels." ;;
  prime)
    symbol="${2:-XAUUSD}"
    ask "IRENX PRIME $symbol. Apply the complete sequence REGIME -> LIQUIDITY -> REFLEXIVITY -> OROCHI -> VMAP -> EXECUTION -> RISK MANAGEMENT. VMAP is confirmation only. No indicator alone may trigger a trade. Return Bias, Entry/Zone, SL, TP1, TP2, TP3, Trigger/Confirmation, and Status. If reliable live market data is unavailable, return WAIT/NO TRADE and do not fabricate numeric levels." ;;
  ask)
    [[ $# -ge 2 ]] || { echo 'Usage: irenx ask "question"' >&2; exit 2; }
    ask "$2" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
