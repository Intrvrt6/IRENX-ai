TWELVEDATA_API_KEY=
MARKET_PROVIDER=twelvedata
IRENX_MARKET_INTERVAL=1min
IRENX_MARKET_OUTPUTSIZE=100
STATUSPAGE_API_KEY=
STATUSPAGE_PAGE_ID=

# OpenAI Responses API (server-side only)
OPENAI_API_KEY=
IRENX_OPENAI_MODEL=gpt-5.6
IRENX_OPENAI_SEARCH_CONTEXT=medium

# OmniRoute upstream (server-side only; fallback)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=

# Optional auth for the IRENX OpenAI-compatible gateway
IRENX_GATEWAY_API_KEY=
IRENX_COPILOT_RESPECT_MODEL=0

# Platform v2 identity and policy (server-side only)
IRENX_AUTH_ISSUER=
IRENX_AUTH_AUDIENCE=irenx
IRENX_JWKS_URL=
IRENX_RBAC_DEFAULT_ROLE=viewer
IRENX_POLICY_ENFORCEMENT=deny-by-default
IRENX_MCP_AUTH_REQUIRED=1
IRENX_AUDIT_ENABLED=1

# Dify self-hosted/API bridge (server-side only)
DIFY_BASE_URL=http://127.0.0.1:5001
DIFY_API_KEY=
DIFY_TIMEOUT_MS=120000

# Odoo 19 JSON-2 integration (server-side only)
ODOO_BASE_URL=https://irnx.odoo.com
ODOO_API_KEY=
ODOO_DATABASE=irnx.core
ODOO_TIMEOUT_MS=15000
ODOO_SIGNAL_MODEL=irenx.signal
IRENX_SIGNAL_INGEST_KEY=

# Google People API (server-side only)
GOOGLE_PEOPLE_ACCESS_TOKEN=
GOOGLE_PEOPLE_TIMEOUT_MS=15000
GOOGLE_PEOPLE_INGEST_KEY=

# Google Cloud Logging / Cloud Run
GOOGLE_CLOUD_PROJECT=irenx-506618
GCP_PROJECT_ID=irenx-506618
IRENX_LOG_SERVICE=irenx-api

# OpenTelemetry
OTEL_SERVICE_NAME=irenx-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_ENABLED=1
OTEL_METRICS_ENABLED=1
OTEL_LOGS_ENABLED=1

# Persistent platform state / audit / cost store
IRENX_STATE_BACKEND=memory
IRENX_DATABASE_URL=
IRENX_AUDIT_RETENTION_DAYS=90
IRENX_COST_RETENTION_DAYS=365

# Cost Engine
IRENX_COST_BUDGET_USD=2
IRENX_COST_ALERT_THRESHOLD=0.8
IRENX_COST_HARD_LIMIT=1

# Remote MCP endpoint
MCP_PUBLIC_ORIGIN=https://ai.irenx.com

# Recovery-code storage (server-side secret store only)
# Do NOT paste real recovery codes into this file or commit them to Git.
IRENX_RECOVERY_CODES=
